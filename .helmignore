# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitlab-ci-local/
.gitlab-ci.yml
.helmignore
.yamllint
README.md
README.md.gotmpl
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# Other
.claude/
.helmdocsignore
tests/
Makefile
CONTRIBUTING.md
LICENSE
